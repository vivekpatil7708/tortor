# ToroPay Payments app — local OAuth/dev tooling.
# Copy to .env and fill with the credentials Shopify Partners gives you.
# The payments extension itself points at the ToroPay platform gateway, so this
# env only matters for install/callback testing via `npm run dev`.

SHOPIFY_API_KEY=replace_with_partners_api_key
SHOPIFY_API_SECRET=replace_with_partners_api_secret
SHOPIFY_API_VERSION=2026-07
# Public HTTPS origin that Shopify can reach (also sends OAuth the callback).
SHOPIFY_APP_ORIGIN=https://checkout.toropay.co.in
# The dev server host used by the local CLI, if you test install locally.
SHOPIFY_DEV_HOST=localhost