generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

// Products
enum ProductType {
  physical
  digital
  service
}

enum ProductStatus {
  active
  draft
  archived
}

// Orders
enum OrderSource {
  manual_order
  payment_link
  website_api
  instagram
  whatsapp
  imported
  other
}

enum PaymentStatus {
  pending
  paid
  failed
  expired
  refunded
}

enum OrderStatus {
  pending_payment
  new
  processing
  on_hold
  completed
  cancelled
}

enum FulfillmentSummaryStatus {
  unfulfilled
  partially_fulfilled
  fulfilled
  partially_delivered
  delivered
  attention_required
  returned
  cancelled
}

// Fulfillments & delivery
enum FulfillmentType {
  shipping
  local_delivery
  pickup
  digital
  service
}

enum FulfillmentStatus {
  unfulfilled
  processing
  packed
  shipped
  in_transit
  out_for_delivery
  delivered
  delivery_failed
  returned
  cancelled
}

enum PackageStatus {
  not_shipped
  shipped
  in_transit
  out_for_delivery
  delivered
  delivery_failed
  returned
  cancelled
}

enum ShipmentEventSource {
  merchant
  system
}

enum StatusHistoryType {
  payment
  order
  fulfillment
  shipment
}

enum ChangedByType {
  merchant
  system
  admin
}

// ============================================================
// MERCHANTS
// ============================================================

model Merchant {
  id                   String   @id @default(uuid())
  email                String   @unique
  phone                String?  @unique
  passwordHash         String?  @map("password_hash")
  provider             String?  @default("email")
  name                 String?  @default("")
  avatarUrl            String?  @map("avatar_url")
  businessName         String   @default("") @map("business_name")
  businessLogoUrl      String?  @map("business_logo_url")
  brandColorPrimary    String   @default("#7bb86c") @map("brand_color_primary")
  brandColorSecondary  String   @default("#2c2c2c") @map("brand_color_secondary")
  brandFont            String   @default("Inter") @map("brand_font")
  buttonStyle          String   @default("rounded") @map("button_style")
  pageTheme            String   @default("cream") @map("page_theme")
  customDomain         String?  @map("custom_domain")
  bgImageUrl           String?  @map("bg_image_url")
  status               String   @default("active")
  onboardingComplete   Boolean  @default(false) @map("onboarding_complete")
  resetToken           String?  @map("reset_token")
  resetTokenExpiry     DateTime? @map("reset_token_expiry")
  loginAttempts        Int      @default(0) @map("login_attempts")
  lockedUntil          DateTime? @map("locked_until")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Phase 1 merchant operations fields
  supportEmail    String? @map("support_email")
  supportPhone    String? @map("support_phone")
  address         String? @map("address")
  defaultCurrency String  @default("INR") @map("default_currency")
  timezone        String  @default("Asia/Kolkata") @map("timezone")

  upiIds        UpiId[]
  paymentLinks  PaymentLink[]
  transactions  Transaction[]
  templates     Template[]
  apiKeys       ApiKey[]
  settings      MerchantSettings?
  webhookLogs   WebhookLog[]
  messageTemplates MessageTemplate[]
  messageLogs     MessageLog[]
  channelConnections ChannelConnection[]

  // Phase 1 merchant operations relations
  merchantUsers      MerchantUser[]
  customers          Customer[]
  customerAddresses  CustomerAddress[]
  products           Product[]
  orders             Order[]
  fulfillments       Fulfillment[]
  packages           Package[]
  shipmentEvents     ShipmentEvent[]
  orderStatusHistory OrderStatusHistory[]
  auditLogs          AuditLog[]

  @@map("merchants")
}

model MerchantUser {
  id            String   @id @default(uuid())
  merchantId    String   @map("merchant_id")
  name          String
  email         String
  passwordHash  String?  @map("password_hash")
  role          String   @default("owner") // owner / admin / staff
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, email])
  @@map("merchant_users")
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id          String    @id @default(uuid())
  merchantId  String    @map("merchant_id")
  fullName    String    @map("full_name")
  phone       String?
  email       String?
  tags        Json?     @default("[]")
  notes       String?
  totalOrders Int       @default(0) @map("total_orders")
  totalSpent  Float     @default(0) @map("total_spent")
  lastOrderAt DateTime? @map("last_order_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  merchant  Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  orders    Order[]

  @@index([merchantId, fullName])
  @@index([merchantId, phone])
  @@index([merchantId, email])
  @@map("customers")
}

model CustomerAddress {
  id            String  @id @default(uuid())
  merchantId    String  @map("merchant_id")
  customerId    String  @map("customer_id")
  label         String?
  recipientName String  @map("recipient_name")
  phone         String?
  line1         String
  line2         String?
  city          String
  state         String
  pincode       String
  country       String  @default("India")
  isDefault     Boolean @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([merchantId, customerId])
  @@map("customer_addresses")
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id               String        @id @default(uuid())
  merchantId       String        @map("merchant_id")
  name             String
  description      String?
  sku              String?
  price            Decimal       @db.Decimal(10, 2)
  compareAtPrice   Decimal?      @db.Decimal(10, 2) @map("compare_at_price")
  imageUrl         String?       @map("image_url")
  productType      ProductType   @map("product_type")
  status           ProductStatus @default(active)
  stockQuantity    Int?          @map("stock_quantity")
  lowStockThreshold Int?         @map("low_stock_threshold")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  merchant     Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@index([merchantId, status])
  @@map("products")
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id                       String                  @id @default(uuid())
  merchantId               String                  @map("merchant_id")
  customerId               String?                 @map("customer_id")
  orderNumber              String                  @map("order_number")
  source                   OrderSource             @default(manual_order)
  currency                 String                  @default("INR")
  subtotalAmount           Decimal                 @db.Decimal(10, 2) @map("subtotal_amount")
  discountAmount           Decimal                 @default(0) @db.Decimal(10, 2) @map("discount_amount")
  shippingAmount           Decimal                 @default(0) @db.Decimal(10, 2) @map("shipping_amount")
  taxAmount                Decimal                 @default(0) @db.Decimal(10, 2) @map("tax_amount")
  totalAmount              Decimal                 @db.Decimal(10, 2) @map("total_amount")
  paymentStatus            PaymentStatus           @default(pending) @map("payment_status")
  orderStatus              OrderStatus             @default(new) @map("order_status")
  fulfillmentSummaryStatus FulfillmentSummaryStatus @default(unfulfilled) @map("fulfillment_summary_status")
  shippingAddressSnapshot  Json?                   @map("shipping_address_snapshot")
  billingAddressSnapshot   Json?                   @map("billing_address_snapshot")
  internalNotes            String?                 @map("internal_notes")
  customerNote             String?                 @map("customer_note")
  trackingToken            String?                 @unique @map("tracking_token")
  createdAt                DateTime                @default(now()) @map("created_at")
  paidAt                   DateTime?               @map("paid_at")
  cancelledAt              DateTime?               @map("cancelled_at")
  completedAt              DateTime?               @map("completed_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")

  merchant            Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderItems          OrderItem[]
  fulfillments        Fulfillment[]
  statusHistory       OrderStatusHistory[]

  @@unique([merchantId, orderNumber])
  @@index([merchantId, createdAt])
  @@index([merchantId, paymentStatus])
  @@index([merchantId, orderStatus])
  @@index([merchantId, fulfillmentSummaryStatus])
  @@index([merchantId, source])
  @@map("orders")
}

model OrderItem {
  id                 String   @id @default(uuid())
  orderId            String   @map("order_id")
  productId          String?  @map("product_id")
  productNameSnapshot String  @map("product_name_snapshot")
  skuSnapshot        String?  @map("sku_snapshot")
  unitPrice          Decimal  @db.Decimal(10, 2) @map("unit_price")
  quantityOrdered    Int      @map("quantity_ordered")
  quantityFulfilled  Int      @default(0) @map("quantity_fulfilled")
  quantityCancelled  Int      @default(0) @map("quantity_cancelled")
  quantityReturned   Int      @default(0) @map("quantity_returned")
  lineTotal          Decimal  @db.Decimal(10, 2) @map("line_total")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  fulfillmentItems FulfillmentItem[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ============================================================
// FULFILLMENTS, PACKAGES & SHIPMENTS
// ============================================================

model Fulfillment {
  id                String            @id @default(uuid())
  merchantId        String            @map("merchant_id")
  orderId           String            @map("order_id")
  fulfillmentNumber String            @map("fulfillment_number")
  fulfillmentType   FulfillmentType   @default(shipping) @map("fulfillment_type")
  status            FulfillmentStatus @default(unfulfilled)
  createdAt         DateTime          @default(now()) @map("created_at")
  processingAt      DateTime?         @map("processing_at")
  packedAt          DateTime?         @map("packed_at")
  shippedAt         DateTime?         @map("shipped_at")
  deliveredAt       DateTime?         @map("delivered_at")
  cancelledAt       DateTime?         @map("cancelled_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  merchant     Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items        FulfillmentItem[]
  packages     Package[]
  statusHistory OrderStatusHistory[]

  @@unique([merchantId, fulfillmentNumber])
  @@index([merchantId, orderId])
  @@map("fulfillments")
}

model FulfillmentItem {
  id            String   @id @default(uuid())
  fulfillmentId String   @map("fulfillment_id")
  orderItemId   String   @map("order_item_id")
  quantity      Int
  createdAt     DateTime @default(now()) @map("created_at")

  fulfillment Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([fulfillmentId, orderItemId])
  @@index([orderItemId])
  @@map("fulfillment_items")
}

model Package {
  id                String          @id @default(uuid())
  merchantId        String          @map("merchant_id")
  fulfillmentId     String          @map("fulfillment_id")
  courierProvider   String?         @map("courier_provider")
  trackingNumber    String?         @map("tracking_number")
  trackingUrl       String?         @map("tracking_url")
  packageStatus     PackageStatus   @default(not_shipped) @map("package_status")
  estimatedDeliveryAt DateTime?     @map("estimated_delivery_at")
  shippedAt         DateTime?       @map("shipped_at")
  deliveredAt       DateTime?       @map("delivered_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  merchant   Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  fulfillment Fulfillment    @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  events     ShipmentEvent[]

  @@index([merchantId, fulfillmentId])
  @@map("packages")
}

model ShipmentEvent {
  id          String              @id @default(uuid())
  merchantId  String              @map("merchant_id")
  packageId   String              @map("package_id")
  eventLabel  String              @map("event_label")
  eventStatus String              @map("event_status")
  location    String?
  eventAt     DateTime            @map("event_at")
  source      ShipmentEventSource @default(merchant)
  createdAt   DateTime            @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  package Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([merchantId, packageId])
  @@map("shipment_events")
}

// ============================================================
// STATUS HISTORY & AUDIT
// ============================================================

model OrderStatusHistory {
  id            String          @id @default(uuid())
  merchantId    String          @map("merchant_id")
  orderId       String          @map("order_id")
  fulfillmentId String?         @map("fulfillment_id")
  packageId     String?         @map("package_id")
  previousStatus String?        @map("previous_status")
  newStatus     String          @map("new_status")
  statusType    StatusHistoryType @map("status_type")
  changedByUserId String?       @map("changed_by_user_id")
  changedByType ChangedByType   @default(merchant) @map("changed_by_type")
  changeReason  String?         @map("change_reason")
  createdAt     DateTime        @default(now()) @map("created_at")

  merchant    Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillment Fulfillment? @relation(fields: [fulfillmentId], references: [id], onDelete: SetNull)

  @@index([merchantId, orderId])
  @@map("order_status_history")
}

model AuditLog {
  id         String   @id @default(uuid())
  merchantId String?  @map("merchant_id")
  email      String
  action     String   // signup, login, logout, order_created, ...
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  // Phase 1 merchant operations audit fields
  actorUserId String? @map("actor_user_id")
  entityType  String? @map("entity_type")
  entityId    String? @map("entity_id")
  metadata    Json?   @map("metadata")

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model UpiId {
  id         String    @id @default(uuid())
  merchantId String    @map("merchant_id")
  vpa        String
  isPrimary  Boolean   @default(false) @map("is_primary")
  verifiedAt DateTime? @map("verified_at")
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, vpa])
  @@map("upi_ids")
}

model PaymentLink {
  id             String    @id @default(uuid())
  merchantId     String    @map("merchant_id")
  upiId          String    @map("upi_id")
  title          String
  description    String?
  amount         Float?
  amountFlexible Boolean   @default(false) @map("amount_flexible")
  minAmount      Float?    @map("min_amount")
  maxAmount      Float?    @map("max_amount")
  customFields   String    @default("[]") @map("custom_fields")
  expiryAt       DateTime? @map("expiry_at")
  maxUses        Int?      @map("max_uses")
  useCount       Int       @default(0) @map("use_count")
  redirectUrl    String?   @map("redirect_url")
  buttonText     String?   @map("button_text")
  webhookUrl     String?   @map("webhook_url")
  slug           String    @unique
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("payment_links")
}

model Template {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  name       String
  config     String   @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("templates")
}

model Transaction {
  id                String    @id @default(uuid())
  merchantId        String    @map("merchant_id")
  paymentLinkId     String?   @map("payment_link_id")
  txnId             String    @unique @map("txn_id")
  upiTxnId          String?   @map("upi_txn_id")
  amount            Float
  customerName      String?   @map("customer_name")
  customerPhone     String?   @map("customer_phone")
  customerEmail     String?   @map("customer_email")
  customerNote      String?   @map("customer_note")
  customFieldValues String    @default("{}") @map("custom_field_values")
  status            String    @default("initiated")
  settlementStatus  String    @default("pending") @map("settlement_status")
  settlementAmount  Float?    @map("settlement_amount")
  settlementDate    DateTime? @map("settlement_date")
  paymentApp        String?   @map("payment_app")
  payerVpa          String?   @map("payer_vpa")
  upiPaymentRef     String?   @map("upi_payment_ref")
  errorMessage      String?   @map("error_message")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")
  confirmedAt       DateTime? @map("confirmed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  paymentLink  PaymentLink?  @relation(fields: [paymentLinkId], references: [id], onDelete: SetNull)
  webhookLogs  WebhookLog[]

  @@map("transactions")
}

model WebhookLog {
  id            String    @id @default(uuid())
  merchantId    String    @map("merchant_id")
  transactionId String?   @map("transaction_id")
  url           String
  payload       String    @default("{}")
  responseCode  Int?      @map("response_code")
  responseBody  String?   @map("response_body")
  deliveredAt   DateTime? @map("delivered_at")
  nextRetryAt   DateTime? @map("next_retry_at")
  retryCount    Int       @default(0) @map("retry_count")
  status        String    @default("pending")

  merchant    Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("webhook_logs")
}

model ApiKey {
  id         String    @id @default(uuid())
  merchantId String    @map("merchant_id")
  name       String
  keyHash    String    @map("key_hash")
  keyPrefix  String    @map("key_prefix")
  scopes     String    @default("[\"read\"]")
  expiresAt  DateTime? @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model PageView {
  id        String   @id @default(uuid())
  path      String
  ipAddress String?  @map("ip_address")
  referrer  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("page_views")
}

model MessageTemplate {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  channel    String   // email / whatsapp / instagram
  name       String
  subject    String   @default("")
  body       String
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, channel, name])
  @@map("message_templates")
}

model MessageLog {
  id               String   @id @default(uuid())
  merchantId       String   @map("merchant_id")
  orderId          String?  @map("order_id")
  channel          String   // email / whatsapp / instagram
  recipient        String
  subject          String   @default("")
  renderedBody     String   @map("rendered_body")
  status           String   @default("pending") // pending / sent / failed
  provider         String   @default("") // resend / twilio / meta / manual
  providerMessageId String? @map("provider_message_id")
  errorMessage     String?  @map("error_message")
  createdBy        String   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("message_logs")
}

model ChannelConnection {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  channel    String   // email / whatsapp / instagram
  status     String   @default("disconnected") // connected / disconnected / error
  accountId  String?  @map("account_id")
  metadata   String   @default("{}") // JSON blob for channel-specific data
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, channel])
  @@map("channel_connections")
}

model MerchantSettings {
  merchantId           String   @id @map("merchant_id")
  smsEnabled           Boolean  @default(false) @map("sms_enabled")
  emailEnabled         Boolean  @default(false) @map("email_enabled")
  autoSettlement       Boolean  @default(true) @map("auto_settlement")
  settlementFrequency  String   @default("daily") @map("settlement_frequency")
  notificationEmail    String?  @map("notification_email")
  notificationPhone    String?  @map("notification_phone")
  webhookSecret        String?  @map("webhook_secret")
  updatedAt            DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_settings")
}

model FeedbackResponse {
  id            String   @id @default(uuid())
  merchantName  String   @map("merchant_name")
  satisfaction  Int      // 1-5
  easeOfUse     Int      @map("ease_of_use") // 1-5
  usefulParts   String   @default("[]") @map("useful_parts") // JSON array
  easeCollecting String  @map("ease_collecting")
  likesMost     String?  @map("likes_most")
  issues        String?  @map("issues")
  improvement   String?  @map("improvement")
  npsScore      Int      @map("nps_score") // 0-10
  followUp      Boolean  @map("follow_up")
  contact       String?  @map("contact")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("feedback_responses")
}