# PostgreSQL connection (Supabase / local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/toropay"

# JWT secret for session tokens — generate a random one
JWT_SECRET="change-this-to-a-long-random-string-at-least-32-chars"

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenWA — self-hosted WhatsApp gateway (alternative to Meta's Cloud API).
# When all three are set, WhatsApp messages are sent through OpenWA instead of
# the WHATSAPP_* Meta credentials. Leave them unset to disable OpenWA.
#
# OPENWA_URL must be reachable from wherever this app runs: localhost works for
# local dev only, Vercel cannot reach your machine (use a tunnel, e.g.
# `cloudflared tunnel --url http://localhost:2785`).
OPENWA_URL="http://localhost:2785"
# The gateway's API key (OpenWA -> Settings -> API keys), sent as X-API-Key.
OPENWA_API_KEY=""
# The session UUID, NOT its display name. The name is rejected by the gateway
# with 400 "Session '<name>' is not active". Find it in `GET /api/sessions`.
OPENWA_SESSION_ID=""
# Country code assumed for a customer number written without one, e.g. a bare
# 10-digit "9876543210". Defaults to 91 (India). Guessing wrong does not fail:
# it sends to a DIFFERENT real number, because 9172632189 is a US number while
# 919172632189 is an unrelated Indian one.
OPENWA_DEFAULT_COUNTRY_CODE="91"

# WhatsApp early access — comma-separated merchant emails allowed to send
# WhatsApp messages. Anyone not listed still sees "Coming soon" on the messaging
# page and gets a 501 if they call the send route.
#
# The ADMIN_EMAIL account is always allowed, so the operator can test without
# listing themselves. Leave this unset to allow the admin account only: a
# missing value must never enable sending for every merchant.
#
# Example: WHATSAPP_ENABLED_MERCHANTS="tester@example.com,another@example.com"
WHATSAPP_ENABLED_MERCHANTS=""
