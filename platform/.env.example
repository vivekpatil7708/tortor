# PostgreSQL connection (Supabase / local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/toropay"

# JWT secret for session tokens — generate a random one
JWT_SECRET="change-this-to-a-long-random-string-at-least-32-chars"

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Phase 2 — API keys
# Peppers key hashes so key hashes alone can't be turned back into keys.
# Defaults to JWT_SECRET when not set.
# API_KEY_PEPPER="another-long-random-string"

# Phase 2 — Payment provider webhooks
# Mock provider (default in local/test). Verify inbound mock webhooks with this.
MOCK_WEBHOOK_SECRET="toropay-mock-webhook-secret"

# Razorpay — only used when BOTH key id and secret are set, otherwise flows
# silently use the mock provider.
# RAZORPAY_KEY_ID="rzp_live_xxx"
# RAZORPAY_KEY_SECRET="xxx"
# RAZORPAY_WEBHOOK_SECRET="xxx"

# Cashfree — only used when both are set.
# CASHFREE_APP_ID="xxx"
# CASHFREE_SECRET_KEY="xxx"
# CASHFREE_WEBHOOK_SECRET="xxx"

# Phase 2 — Email confirmations
# When set, transactional emails go through Resend; otherwise the local mock
# email provider is used (logs are still stored in the DB via email_logs).
# RESEND_API_KEY="re_xxx"
